# Copy to .env.local and fill in. Never commit real values.

# API origin.
API_BASE_URL=

# Key for the encrypted httpOnly session cookie. 32+ random bytes.
SESSION_SECRET=

# Proves to the API that a call came from us, so the end user's IP we forward is
# trusted. Must match one entry in the backend's BFF_HOP_SECRETS. 32+ characters,
# from: openssl rand -base64 32
BFF_HOP_SECRET=

# Google Sign-In client id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=